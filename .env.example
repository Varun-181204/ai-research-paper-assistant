# ==============================================================================
# AI Research Paper Assistant - Environment Configuration Template
# ==============================================================================

# Application
PROJECT_NAME="AI Research Paper Assistant"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL default, falls back to SQLite if not provided or in local dev)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/research_assistant"
# Fallback local sqlite example:
# DATABASE_URL="sqlite:///./research_assistant.db"

# AI / Google Gemini API
GOOGLE_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIRECTORY="./chroma_db"
CHROMA_HOST="localhost"
CHROMA_PORT=8000

# Security & Auth
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=30

# CORS / Frontend URL
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
